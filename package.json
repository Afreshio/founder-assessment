{
  "name": "founder-assessment",
  "private": true,
  "type": "module",
  "description": "Facebook ad test kit for Afresh: landing pages, ad copy, rendered creatives, and checks.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "lint:ads": "node scripts/lint-copy.mjs",
    "render:ads": "node scripts/render-ads.mjs",
    "build:docs": "node scripts/build-ad-docs.mjs",
    "check": "npm run lint:ads && npm test"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.56.1"
  }
}
